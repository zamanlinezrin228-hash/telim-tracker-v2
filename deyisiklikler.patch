+
+.cm-note { display: flex; gap: 8px; align-items: flex-start; font-size: 12.5px; line-height: 1.5; color: var(--blue); background: var(--blue-light); border: 1px solid var(--blue-border); border-radius: 10px; padding: 10px 12px; margin-bottom: 14px; }
+.cm-note svg { flex-shrink: 0; margin-top: 2px; }
+.cm-empty { text-align: center; color: var(--ink-500); padding: 32px; }
+
+.cm-group { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md); overflow: hidden; margin-bottom: 16px; box-shadow: var(--shadow-xs); break-inside: avoid-page; }
+.cm-group-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 13px 16px; font-size: 14.5px; font-weight: 800; color: var(--ink-900); background: var(--blue-light); border-bottom: 1px solid var(--blue-border); }
+.cm-group-count { font-size: 12px; font-weight: 700; color: var(--blue); background: var(--surface); border: 1px solid var(--blue-border); border-radius: 99px; padding: 2px 10px; }
+.cm-comp-head { padding: 9px 16px; font-size: 13px; font-weight: 700; color: var(--ink-700); background: var(--ink-50); border-bottom: 1px solid var(--border); border-top: 1px solid var(--border); }
+.cm-row { display: grid; grid-template-columns: 64px minmax(0, 1fr) 170px 200px; gap: 14px; align-items: center; padding: 11px 16px; border-bottom: 1px solid var(--ink-100); }
+.cm-row:last-child { border-bottom: none; }
+.cm-row-head { padding-top: 8px; padding-bottom: 8px; font-size: 10.5px; font-weight: 700; letter-spacing: .4px; text-transform: uppercase; color: var(--ink-400); background: var(--surface); }
+.cm-row-unmapped .cm-sub { color: var(--ink-500); }
+.cm-code { font-size: 12px; font-weight: 700; color: var(--ink-400); font-variant-numeric: tabular-nums; }
+.cm-sub { font-size: 13.5px; line-height: 1.45; color: var(--ink-900); }
+.cm-en { font-size: 11.5px; font-weight: 400; color: var(--ink-400); margin-top: 2px; }
+.cm-positions { font-size: 11px; color: var(--teal); margin-top: 3px; font-weight: 600; cursor: help; }
+.cm-chip { display: inline-flex; align-items: center; padding: 3px 10px; border: 1px solid; border-radius: 99px; font-size: 12px; font-weight: 700; white-space: nowrap; }
+.cm-meter { display: flex; gap: 3px; }
+.cm-meter i { width: 20px; height: 8px; border-radius: 3px; background: var(--ink-200); }
+.cm-meter-label { font-size: 11.5px; color: var(--ink-500); margin-top: 4px; }
+.cm-muted { font-size: 12px; color: var(--ink-400); }
+
+.cm-legend { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; font-size: 12.5px; color: var(--ink-500); margin-bottom: 10px; }
+.cm-legend-item { display: inline-flex; align-items: center; gap: 5px; color: var(--ink-700); font-weight: 600; }
+.cm-legend-item i { width: 12px; height: 12px; border-radius: 4px; display: inline-block; }
+.cm-matrix table { border-collapse: separate; border-spacing: 0; }
+.cm-matrix th, .cm-matrix td { border-bottom: 1px solid var(--ink-100); }
+.cm-matrix-first { min-width: 320px; max-width: 420px; font-size: 12.5px; line-height: 1.4; text-align: left; }
+.cm-matrix-comp { font-size: 11px; color: var(--ink-400); margin-top: 2px; }
+.cm-vert-th { vertical-align: bottom; padding: 8px 2px !important; }
+.cm-vert { writing-mode: vertical-rl; transform: rotate(180deg); max-height: 190px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; border: none; background: none; font-size: 11.5px; font-weight: 600; color: var(--ink-700); cursor: pointer; padding: 2px; }
+.cm-vert:hover { color: var(--blue); }
+.cm-matrix-cell { text-align: center; padding: 5px 4px !important; }
+.cm-cell { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 8px; border: 1px solid; font-size: 12.5px; font-weight: 800; }
+
+@media (max-width: 760px) {
+  .cm-control, .cm-control select { width: 100%; min-width: 0; }
+  .cm-row { grid-template-columns: 48px minmax(0, 1fr); row-gap: 8px; }
+  .cm-row-head { display: none; }
+  .cm-col-crit, .cm-col-level { grid-column: 2; }
+  .cm-hero-stat { min-width: calc(50% - 5px); }
+  .cm-matrix-first { min-width: 220px; }
+}
+@media print {
+  .cm-hero { box-shadow: none; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
+  .cm-group { box-shadow: none; }
+}
