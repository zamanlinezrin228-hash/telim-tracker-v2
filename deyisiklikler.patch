+.cm-hero { display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; padding: 22px 24px; margin-bottom: 16px; border-radius: var(--radius-lg); color: #fff; background: linear-gradient(135deg, #0b2545 0%, #123a68 60%, #0f766e 140%); box-shadow: var(--shadow-md); }
