+                                className="cm-cell"
+                                style={{ background: `${col}22`, color: col, borderColor: `${col}66` }}
+                                title={`${p}\nTələb olunan: ${r.required_level ?? '—'} · Kritiklik: ${r.criticality ?? '—'}${r.criticality ? ' (' + CRITICALITY_LABELS[r.criticality] + ')' : ''}`}
+                              >
+                                {r.required_level ?? '·'}
+                              </span>
+                            </td>
+                          );
+                        })}
+                      </tr>
+                    ))}
+                  </tbody>
+                </table>
+              </div>
+            )}
+          </>
+        )}
+      </div>
+    </div>
+  );
+}
